@startuml
left to right direction
skinparam packageStyle rectangle

actor "买家" as Buyer
actor "卖家" as Seller
actor "管理员" as Admin

rectangle "二手交易系统" {
  usecase "浏览/搜索商品" as UC1
  usecase "发起预约" as UC2
  usecase "取消预约" as UC3
  
  usecase "发布商品(存草稿)" as UC4
  usecase "提交审核" as UC5
  usecase "管理个人商品" as UC6
  
  usecase "审核商品" as UC7
  usecase "违规下架/封号" as UC8
  usecase "查看操作日志" as UC9

  Buyer --> UC1
  Buyer --> UC2
  Buyer --> UC3
  
  Seller --> UC4
  Seller --> UC5
  Seller --> UC6
  
  Admin --> UC7
  Admin --> UC8
  Admin --> UC9
}
@enduml